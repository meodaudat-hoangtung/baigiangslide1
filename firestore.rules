rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // System configuration (Admin master password and security settings)
    match /app_config/{configId} {
      allow read, write: if true;
    }

    // Users and Members directory (Admin manages accounts, credentials)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Shared Lessons Collection
    match /lessons/{lessonId} {
      allow read, write: if true;
    }
    
    // Deleted lesson tombstones
    match /deleted_lessons/{lessonId} {
      allow read, write: if true;
    }
  }
}

